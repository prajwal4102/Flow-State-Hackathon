# ───────────────────────── ArmorIQ (mandatory) ─────────────────────────
# Generate at https://platform.armoriq.ai → API Keys. Must start with ak_live_ / ak_test_.
ARMORIQ_API_KEY=
# The owner of the social accounts. Every ArmorIQ decision is attributed to this email, and this is who approves holds.
ARMORIQ_USER_EMAIL=owner@example.com
# ArmorIQ enforces four eyes: whoever files an approval request cannot approve it. Approval requests are filed
# under this second org member (invite a teammate on platform.armoriq.ai → Organization → Members).
ARMORIQ_REQUESTER_EMAIL=operator@example.com
# Agent identities. Register FOUR agents on platform.armoriq.ai with exactly these names
# (Agents → Add Agent). Policies are bound per agent, so names must match exactly.
ARMORIQ_AGENT_PLANNER=studio-planner
ARMORIQ_AGENT_CREATOR=studio-creator
ARMORIQ_AGENT_PUBLISHER=studio-publisher
ARMORIQ_AGENT_EDITOR=studio-editor
# sdk   = ArmorIQ backend evaluates policy before every call, agent executes the MCP tool itself (works locally)
# proxy = every call is routed through proxy.armoriq.ai which verifies the Merkle proof and forwards to the
#         MCP server registered on the platform (MCP servers must be on a public HTTPS URL)
ARMORIQ_MODE=sdk
# Seconds a minted intent token stays valid. Keep long enough for a video generation to finish.
ARMORIQ_TOKEN_VALIDITY_SECONDS=1800
# How long (seconds) the agent waits for a human to approve a HELD action on the ArmorIQ dashboard.
ARMORIQ_HOLD_TIMEOUT_SECONDS=900

# ───────────────────────── LLM (DeepSeek, OpenAI-compatible) ─────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ───────────────────────── MCP servers ─────────────────────────
MCP_PORT=4100
# Public base URL of the MCP host (ngrok / deployed). Used in tool results and for platform registration.
MCP_PUBLIC_URL=http://localhost:4100
# Where the agent connects to the three MCP endpoints
MCP_RESEARCH_URL=http://localhost:4100/mcp/research
MCP_VIDEO_URL=http://localhost:4100/mcp/video
MCP_SOCIAL_URL=http://localhost:4100/mcp/social

# ───────────────────────── Remotion-Agent (video pipeline) ─────────────────────────
# The pre-existing Remotion-Agent API (apps/api) and web preview (apps/web)
REMOTION_API_URL=http://localhost:3210
REMOTION_WEB_URL=http://localhost:5173
VIDEO_GEN_TIMEOUT_MS=300000
RENDER_WAIT_MS=720000

# ───────────────────────── ElevenLabs (optional sponsor integration) ─────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ───────────────────────── Real distribution: public Telegram bot MCP ─────────────────────────
# Token from @BotFather. When set, the MCP host spawns @node2flow/telegram-bot-mcp (a public, third-party
# MCP server) in HTTP mode and proxies it at /mcp/telegram so ArmorIQ can register and govern it.
TELEGRAM_BOT_TOKEN=
# The private test channel the bot posts into (negative id like -1001234567890). Found via getUpdates.
TELEGRAM_CHAT_ID=
TELEGRAM_MCP_PORT=4300
# Where the agent connects to it (defaults to <MCP host>/mcp/telegram when the token is set)
# MCP_TELEGRAM_URL=http://localhost:4100/mcp/telegram

# ───────────────────────── Real distribution: public Discord MCP ─────────────────────────
# Bot token from discord.com/developers (Bot tab → Reset Token). Needs Message Content, Server Members and
# Presence intents enabled, and the bot invited to a TEST server with Send Messages + Manage Messages.
# When set, the MCP host spawns the public mcp-discord package in HTTP mode and proxies it at /mcp/discord.
DISCORD_BOT_TOKEN=
# The test channel the bot posts into (Developer Mode → right-click channel → Copy Channel ID)
DISCORD_CHANNEL_ID=
DISCORD_MCP_PORT=4310
# MCP_DISCORD_URL=http://localhost:4100/mcp/discord

# ───────────────────────── Sandbox publishing ─────────────────────────
# Optional: a Discord channel webhook so "publish" lands somewhere real but harmless.
DISCORD_WEBHOOK_URL=

# ───────────────────────── Agent console ─────────────────────────
AGENT_PORT=4200
